  <!-- SLIDE 9: VISION -->
  <DeckSlide n={9} total={TOTAL} eyebrow="The Vision" heading="In three years, a second-year nurse knows what 200 experienced nurses did in her exact situation." tone="deep">
    <div class="max-w-(--container-prose) space-y-8" data-reveal>
      <p class="text-lead">Our goal: 50,000 Wisdom Nodes across healthcare. Tero is designed to surface the right wisdom at the right moment, and the reasoning layer becomes context that clinical AI, decision support, and training systems can reference.</p>
