  </DeckSlide>

  <!-- SLIDE 8: THE ASK -->
  <DeckSlide n={8} total={TOTAL} eyebrow="The Ask" heading="$1M to build the reasoning layer." tone="paper">
    <div class="grid-12 gap-y-12">
      <div class="col-span-12 lg:col-span-6" data-reveal>
        <p class="text-lead">Raising $1,000,000 on a SAFE at a $10M valuation cap. Minimum check $25,000.</p>
