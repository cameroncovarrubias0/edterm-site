---
// /pitch: the investor brief, in the site's design system.
// Source: the owner's finished deck (EdTerm-Site/pitch-final.html), same 9 slides, numbers and sources,
// with owner-approved edits: new cover headline; fieldwork by region, not country; no application lines;
// ACE2026 in past tense; Lindenwood study wording; peer-reviewed (never "validated"); softened superlatives;
// no node field structure; node counts as goals only (Node #004831 is the only captured node);
// Tero described as designed, not live. Do not edit claims here without the owner.
//
// Rules (see CLAUDE.md): never linked from any page, nav, footer, sitemap or button; always noindex
// (meta tag via `noindex` below + X-Robots-Tag header in vercel.json); excluded from the sitemap.
import BaseLayout from '../layouts/BaseLayout.astro';
import DeckSlide from '../components/DeckSlide.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';

const TOTAL = 9;

const workflow = [
  { verb: 'Identify', rest: 'retiring clinical staff with irreplaceable judgment' },
  { verb: 'Interview', rest: 'using peer-reviewed Wisdom Journalism methodology' },
  { verb: 'Structure', rest: 'into Wisdom Nodes' },
  { verb: 'Surface', rest: 'via Tero — matched to the situation, not just a keyword search' },
];

const funds = [
  { label: 'Technical development', pct: 35 },
  { label: 'University pilot programs', pct: 20 },
  { label: 'Global research presence', pct: 15 },
  { label: 'Legal and data systems', pct: 15 },
  { label: 'Operations & salary', pct: 15 },
];

const milestones = [
  'Goal: 1,000 Wisdom Nodes across the healthcare pilot',
  '4 university partnerships active and collecting',
  'First enterprise B2B engagement closed',
  'Tero v1 beta live — AI retrieval layer operational',
  'Technical co-founder hired',
  '18 months runway to Series A positioning',
];

const card = 'rounded-card border p-6 sm:p-8';
const cardLight = `${card} border-line bg-white`;
const cardDark = `${card} border-white/12 bg-white/[0.04]`;
const dot = 'mt-[0.6em] size-1.5 shrink-0 rounded-full';
const statNum = 'font-display text-[length:clamp(2.75rem,2rem+3vw,4rem)] font-extrabold leading-none';
---

<BaseLayout
  title="EdTerm — Investor Brief"
  description="EdTerm investor brief."
  noindex
  bare
>
  <!-- Sticky deck bar: logo, current slide label, progress. Works as a static label without JS. -->
  <div slot="bar" class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
    <div class="container-site flex h-16 items-center justify-between gap-4">
      <a href="/" class="shrink-0" aria-label="EdTerm home"><Logo height={40} class="h-7 sm:h-9" /></a>
      <p class="label truncate text-purple-700">
        <span class="text-ink-muted" data-deck-num>01 / 09</span>
        <span class="ml-3" data-deck-title>Investor Brief · 2026</span>
      </p>
      <a href="mailto:partners@edterm.com" class="hidden text-small font-semibold text-navy hover:text-purple-700 md:inline">partners@edterm.com</a>
    </div>
    <div class="h-0.5 bg-line" aria-hidden="true">
      <div class="h-full bg-gold-500 transition-[width] duration-300 motion-reduce:transition-none" style={`width:${100 / TOTAL}%`} data-deck-progress></div>
    </div>
  </div>

  <!-- SLIDE 1: COVER (full hero, as on Home) -->
  <section
    id="slide-1"
    data-slide="1"
    data-title="Investor Brief · 2026"
    class="on-dark relative overflow-hidden rounded-b-hero bg-[linear-gradient(135deg,var(--color-navy)_0%,var(--color-navy)_35%,var(--color-purple-900)_75%,var(--color-purple-700)_100%)] text-white"
    aria-labelledby="slide-1-heading"
  >
    <div class="container-site grid-12 gap-y-14 pb-20 pt-16 sm:pb-28 sm:pt-24 lg:pb-32 lg:pt-28">
      <div class="col-span-12 lg:col-span-7" data-reveal>
        <p class="label text-gold-300">Investor Brief · 2026</p>
        <h1 id="slide-1-heading" class="mt-6 text-display font-extrabold"><span class="block">The data is there.</span> <span class="block">The judgment behind it isn’t.</span></h1>
        <p class="mt-8 max-w-(--container-lead) text-lead text-white/85">
          EdTerm is a healthcare data infrastructure company building the reasoning layer — the structured expert
          judgment that EHRs and genomic databases cannot capture, collected from experienced clinicians before they retire.
        </p>
        <p class="mt-8 text-small text-white/70">Cameron Covarrubias · Founder &nbsp;·&nbsp; partners@edterm.com</p>
      </div>
      <div class="col-span-12 flex flex-col gap-8 lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>
        <figure>
          <blockquote class="font-quote text-h3 italic leading-snug text-white">
            <p>"You can read something in a book or you can do it for 30 years. They're not the same."</p>
          </blockquote>
          <figcaption class="label mt-4 text-white/60">— The EdTerm Thesis</figcaption>
        </figure>
        <!-- @container: the amount scales to the box's own width, so it always fits inside it. -->
        <div class="@container rounded-card border border-white/15 bg-white/[0.05] p-6">
          <p class="label text-gold-300">Raising</p>
          <p class="mt-2 whitespace-nowrap font-display text-[length:min(3.75rem,15cqw)] font-extrabold leading-tight text-white">$1,000,000</p>
          <p class="mt-2 text-small text-white/75">SAFE · $10M Valuation Cap · Minimum Check $25K</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SLIDE 2: PROBLEM -->
  <DeckSlide n={2} total={TOTAL} eyebrow="The Problem" heading="Every retirement is a permanent knowledge erasure." tone="white">
    <div class="grid-12 gap-y-12">
      <dl class="col-span-12 grid gap-8 sm:grid-cols-3 lg:col-span-5 lg:grid-cols-1" data-reveal>
        <div>
          <dt class="sr-only">$5.19M</dt>
          <dd>
            <p class:list={[statNum, 'text-purple-700']} aria-hidden="true">$5.19M</p>
            <p class="mt-3 text-ink-muted">Lost annually per hospital system to RN turnover alone (NSI, 2026 report)</p>
          </dd>
        </div>
        <div>
          <dt class="sr-only">40%</dt>
          <dd>
            <p class:list={[statNum, 'text-purple-700']} aria-hidden="true">40%</p>
            <p class="mt-3 text-ink-muted">Of nurses plan to retire or leave within five years</p>
          </dd>
        </div>
        <div>
          <dt class="sr-only">1M+</dt>
          <dd>
            <p class:list={[statNum, 'text-purple-700']} aria-hidden="true">1M+</p>
            <p class="mt-3 text-ink-muted">RNs projected to exit the workforce by end of the decade</p>
          </dd>
        </div>
      </dl>
      <div class="col-span-12 max-w-(--container-prose) space-y-4 lg:col-span-6 lg:col-start-7" data-reveal>
        <p>When an experienced practitioner retires or leaves, the judgment they built over a career — the thing that actually makes them good at the job — walks out the door with them. It was never written down because it isn’t the kind of knowledge that writes down easily: it’s pattern recognition and situational judgment, the stuff you only get from doing the job for 20+ years.</p>
        <p>The cost shows up as turnover and re-learning, not as a line item for “lost knowledge.” Beyond healthcare, Panopto (2018) estimated that large US businesses lose $47M a year to inefficient knowledge sharing. Universities, meanwhile, train the next generation on textbooks and documentation — never on what practitioners actually learned on the job. The loop is broken.</p>
        <p class="!mt-8 border-l-2 border-gold-500 pl-5 font-display text-lead font-bold text-navy">Healthcare data records what happened. Nothing records how an experienced clinician read it.</p>
      </div>
    </div>
  </DeckSlide>

  <!-- SLIDE 3: SOLUTION -->
  <DeckSlide n={3} total={TOTAL} eyebrow="The Solution" heading="The reasoning layer. Captured, structured, searchable." tone="deep">
    <div class="grid-12 gap-y-12">
      <div class="col-span-12 lg:col-span-6" data-reveal>
        <div class="max-w-(--container-prose) space-y-4">
          <p>EHRs record what was presented and treated. Genomic databases record what is possible. Neither captures how an experienced clinician interpreted the signals. The Human Wisdom Database (HWD) captures that reasoning through Wisdom Journalism, a peer-reviewed methodology, and is designed to make it retrievable through an AI layer called Tero.</p>
          <p>A Wisdom Node is a structured record of a specific moment of professional judgment. The first node is captured: Node #004831, a Senior ED nurse with 32 years of experience. Every node is designed to be sourced to a real practitioner’s actual judgment, captured before it’s lost — not scraped from documentation that was already written down.</p>
        </div>
        <!-- Connected sequence, same pattern as the site's capture steps -->
        <ol class="mt-10">
          {
            workflow.map((s, i) => (
              <li class="relative pb-7 pl-10 last:pb-0 after:absolute after:bottom-[-1px] after:left-[7px] after:top-[17px] after:w-0.5 after:bg-gold-500/40 after:content-[''] last:after:hidden">
                <span class="absolute left-0 top-px size-4 rounded-full border-2 border-gold-500 bg-deep" aria-hidden="true" />
                <span class="label block text-gold-300">{String(i + 1).padStart(2, '0')}</span>
                <p class="mt-1"><strong class="font-semibold text-white">{s.verb}</strong> {s.rest}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="col-span-12 lg:col-span-5 lg:col-start-8" data-reveal>
        <article class={cardDark}>
          <header class="border-b border-white/12 pb-5">
            <p class="label text-gold-300">Node #004831</p>
            <p class="mt-2 text-small text-white/70">Senior Emergency Department Nurse · 32 Years Clinical Experience</p>
          </header>
          <!-- Excerpt only: node field names/structure intentionally not shown. -->
          <div class="mt-6 space-y-5">
            <p class="italic text-white/85">"Sometimes the patient who looks the calmest is the one I'm most worried about. When a normally anxious patient suddenly becomes unusually quiet and their family starts answering questions for them — I stop. More than once those patients deteriorated within the hour."</p>
            <p class="text-white/85">Has behavior changed unexpectedly? Is the family behaving differently? Does clinical intuition conflict with the vitals? If several indicators present — escalate. Even if metrics haven't crossed intervention thresholds.</p>
            <p class="border-l-2 border-gold-500 pl-4 font-display font-bold text-white">Experienced clinicians don't ignore the data — they recognize when the data hasn't caught up to reality.</p>
          </div>
        </article>
      </div>
    </div>
  </DeckSlide>

  <!-- SLIDE 4: TRACTION -->
  <DeckSlide n={4} total={TOTAL} eyebrow="Traction" heading="Pre-revenue. Real proof." tone="paper">
    <div class="grid gap-4 md:grid-cols-2">
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">Peer Review</p>
        <h3 class="mt-3 text-h3 font-bold">Double-Blind Peer Review Passed</h3>
        <p class="mt-3 text-ink-muted">Wisdom Journalism methodology passed double-blind peer review through the International Academic Forum. Presented at the 18th Annual Asian Conference on Education (ACE2026), Tokyo, 2026.</p>
      </article>
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">Research Study</p>
        <h3 class="mt-3 text-h3 font-bold">IRB Approved — Lindenwood University</h3>
        <p class="mt-3 text-ink-muted">An IRB-approved study through Lindenwood University, now open for participants, in collaboration with Dr. James Hutson. CITI human subjects training completed.</p>
      </article>
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">First Artifact</p>
        <h3 class="mt-3 text-h3 font-bold">First Wisdom Node Captured</h3>
        <p class="mt-3 text-ink-muted">Node #004831 — Senior ED Nurse, 32 years. Reviewed by senior nursing educators.</p>
      </article>
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">Momentum</p>
        <h3 class="mt-3 text-h3 font-bold">Early Funding and Customer Validation</h3>
        <ul class="mt-3 space-y-2 text-ink-muted">
          <li class="flex gap-3"><span class:list={[dot, 'bg-purple-700']} aria-hidden="true"></span><span>Hospital discovery conversations underway as business customer validation (prospect-stage, not yet contracted)</span></li>
          <li class="flex gap-3"><span class:list={[dot, 'bg-purple-700']} aria-hidden="true"></span><span>$50,000 committed by EdTerm’s first investor, on a SAFE at a $10M valuation cap</span></li>
        </ul>
      </article>
      <!-- Full-width fifth card so the 2-column grid stays even -->
      <article class:list={[cardLight, 'md:col-span-2']} data-reveal>
        <p class="label text-purple-700">Conference</p>
        <h3 class="mt-3 text-h3 font-bold">18th Annual Asian Conference on Education (ACE2026), Tokyo, 2026</h3>
        <p class="mt-3 text-ink-muted">Presented the Wisdom Journalism methodology as curriculum design.</p>
      </article>
    </div>
  </DeckSlide>

  <!-- SLIDE 5: MARKET -->
  <DeckSlide n={5} total={TOTAL} eyebrow="The Market" heading="The layer between the data and the decision." tone="deep">
    <div class="grid-12 gap-y-12">
      <div class="col-span-12 space-y-10 lg:col-span-6" data-reveal>
        <div>
          <p class:list={[statNum, 'text-gold-300']}>$62.2B</p>
          <p class="mt-3 max-w-(--container-prose)">Total Addressable Market — Global knowledge management software market by 2033, growing at 13.6% CAGR. Source: <a href="https://www.grandviewresearch.com/industry-analysis/knowledge-management-software-market-report" target="_blank" rel="noopener" class="text-gold-300 underline underline-offset-4 hover:text-white">Grand View Research</a></p>
        </div>
        <div>
          <p class:list={[statNum, 'text-gold-300']}>$9.9B</p>
          <p class="mt-3 max-w-(--container-prose)">Serviceable Addressable Market — Healthcare knowledge management market by 2030, growing at 14.4% CAGR. Source: <a href="https://www.meticulousresearch.com/product/healthcare-knowledge-management-market-6700/toc" target="_blank" rel="noopener" class="text-gold-300 underline underline-offset-4 hover:text-white">Meticulous Research</a></p>
        </div>
        <div>
          <p class:list={[statNum, 'text-gold-300']}>$37.5M</p>
          <p class="mt-3 max-w-(--container-prose)">Serviceable Obtainable Market — ARR at Year 5: 100 hospital systems × 5 departments × $75K average contract</p>
        </div>
        <p class="max-w-(--container-prose) text-small text-white/60">Healthcare is the wedge: nurses, pharmacists, and clinical operations staff. The long-term opportunity is the reasoning layer for clinical AI, decision support, and training systems built on EHR and genomic data — expert reasoning mapped to real clinical contexts.</p>
      </div>
      <div class="col-span-12 lg:col-span-5 lg:col-start-8" data-reveal>
        <div class={cardDark}>
          <h3 class="text-h3 font-bold text-white">Why Now</h3>
          <ul class="mt-6 space-y-4">
            <li class="flex gap-3"><span class:list={[dot, 'bg-white/40']} aria-hidden="true"></span><p>The nursing retirement wave is happening right now — not in five years. All Baby Boomers reach retirement age before 2030.</p></li>
            <li class="flex gap-3"><span class:list={[dot, 'bg-white/40']} aria-hidden="true"></span><p>LLMs can now structure messy human knowledge at scale.</p></li>
            <li class="flex gap-3"><span class:list={[dot, 'bg-white/40']} aria-hidden="true"></span><p>The methodology has passed double-blind peer review, which supports credibility with health systems.</p></li>
            <li class="flex gap-3 border-t border-white/12 pt-4"><span class:list={[dot, 'bg-gold-300']} aria-hidden="true"></span><p class="text-white/85"><strong class="text-white">The moat:</strong> The data does not exist yet. You cannot train a system on reasoning that was never collected. A larger archive reveals patterns no single expert could articulate.</p></li>
          </ul>
        </div>
      </div>
    </div>
  </DeckSlide>

  <!-- SLIDE 6: BUSINESS MODEL -->
  <DeckSlide n={6} total={TOTAL} eyebrow="Business Model" heading="Three phases. Each one compounds." tone="white">
    <div class="grid gap-4 md:grid-cols-3">
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">Phase 1 · Year 1–2</p>
        <h3 class="mt-3 text-h3 font-bold">Enterprise Engagement</h3>
        <p class="mt-3 font-display font-bold text-purple-700">$35,000 – $75,000 per engagement</p>
        <p class="mt-3 text-ink-muted">Deploy trained interviewers with retiring employees. Deliver structured Wisdom Node archive. Annual recurring contracts for ongoing collection.</p>
      </article>
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">Phase 2 · Year 2+</p>
        <h3 class="mt-3 text-h3 font-bold">University Licensing</h3>
        <p class="mt-3 font-display font-bold text-purple-700">$15,000 – $30,000 per institution annually</p>
        <p class="mt-3 text-ink-muted">License Wisdom Journalism curriculum to journalism programs. Students collect nodes. University pays licensing fee. Collection scales globally without adding headcount.</p>
      </article>
      <article class={cardLight} data-reveal>
        <p class="label text-purple-700">Phase 3 · Year 3+</p>
        <h3 class="mt-3 text-h3 font-bold">The Reasoning Layer</h3>
        <p class="mt-3 font-display font-bold text-purple-700">Annual license · Dataset licensing to AI companies</p>
        <p class="mt-3 text-ink-muted">License access to the node archive as it grows, including for clinical AI, decision-support, and training systems. EHRs record what happened and genomic databases record what is possible; the reasoning layer adds how experienced clinicians interpret it. The database compounds every year.</p>
      </article>
    </div>
    <div class="mt-6 rounded-card bg-paper p-6 sm:p-8" data-reveal>
      <h3 class="text-h3 font-bold text-purple-700">The Compounding Moat</h3>
      <p class="mt-3 max-w-(--container-prose)">The peer-reviewed collection methodology, IRB-governed governance, and global university network take years to build — not a feature a competitor can ship in a quarter. Every node collected makes the next node more valuable. The data compounds. The moat widens with every engagement.</p>
    </div>
  </DeckSlide>

  <!-- SLIDE 7: TEAM -->
  <DeckSlide n={7} total={TOTAL} eyebrow="The Team" heading="Built by someone who studied wisdom transfer for twenty years." tone="deep">
    <div class="grid gap-4 md:grid-cols-2">
      <article class={cardDark} data-reveal>
        <h3 class="text-h3 font-bold text-white">Cameron Covarrubias</h3>
        <p class="label mt-2 text-gold-300">Founder &amp; CEO</p>
        <p class="mt-4">Two decades of global fieldwork studying how wisdom transfers through apprenticeship systems and institutions — across North America and Asia. That fieldwork is the origin of the Wisdom Journalism methodology. Solo founder, full-time on EdTerm.</p>
        <ul class="mt-5 space-y-2">
          <li class="flex gap-3"><span class:list={[dot, 'bg-gold-300']} aria-hidden="true"></span><span>Wisdom Journalism peer review passed — IAFOR</span></li>
          <li class="flex gap-3"><span class:list={[dot, 'bg-gold-300']} aria-hidden="true"></span><span>Presented at ACE2026, Tokyo.</span></li>
        </ul>
      </article>
    </div>
    <div class="mt-12" data-reveal>
      <h3 class="text-h3 font-bold text-white">Key Hire This Round</h3>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-card border border-white/12 p-5">
          <p class="font-display font-bold text-white">Technical Co-Founder</p>
          <p class="mt-2 text-small text-white/70">Primary hire this raise funds · Knowledge graph or NLP background</p>
