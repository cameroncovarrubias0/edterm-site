</BaseLayout>

<script>
  // Sticky deck bar: show the slide currently in view and advance the progress line.
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const num = document.querySelector('[data-deck-num]');
  const title = document.querySelector('[data-deck-title]');
  const bar = document.querySelector<HTMLElement>('[data-deck-progress]');
  const total = slides.length;
  const pad = (n: number) => String(n).padStart(2, '0');
  if (num && title && bar && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          const n = Number(el.dataset.slide);
          num.textContent = `${pad(n)} / ${pad(total)}`;
          title.textContent = el.dataset.title ?? '';
          bar.style.width = `${(n / total) * 100}%`;
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    slides.forEach((s) => io.observe(s));
  }
</script>
