            workflow.map((s, i) => (
              <li class="relative pb-7 pl-10 last:pb-0 after:absolute after:bottom-[-1px] after:left-[7px] after:top-[17px] after:w-0.5 after:bg-gold-500/40 after:content-[''] last:after:hidden">
