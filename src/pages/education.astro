---
// For Education: the education-loop story in depth. Copy is from the brief (education loop lines,
// "One source, two outcomes", "Both loops close from the same source") or owner-approved. See CLAUDE.md.
// Never describe education as a market, customer segment or revenue source.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';

const loop = [
  { name: 'Practice', line: 'Practitioners build judgment over years of care.' },
  { name: 'Capture', line: 'EdTerm captures how they reason.' },
  { name: 'Curriculum', line: 'That reasoning returns to the classroom.' },
  { name: 'Next cohort', line: 'Students train on how experienced practitioners actually think.' },
];
const link = 'font-semibold text-purple-700 underline underline-offset-4 hover:text-purple-500';
---

<BaseLayout
  title="For Education — EdTerm"
  description="The same captured reasoning that completes the healthcare data layer returns to curriculum, so the next cohort trains on how experienced practitioners actually think."
>
  <Hero
    label="For education"
    headline="Universities prepare people for industry. What they learn over a career never comes back."
  >
    <p>
      The same captured reasoning that completes the data layer returns to curriculum, so the next cohort trains on
      how experienced practitioners actually think.
    </p>
  </Hero>

  <!-- The gap -->
  <Section tone="white" heading="Knowledge travels one way" id="gap">
    <p>Medical, nursing and university programs prepare students for practice.</p>
    <p>
      Over a career, practitioners learn to read a situation, weigh competing signals and make a judgment call. That
      knowledge rarely returns to the classroom.
    </p>
  </Section>

  <!-- The loop -->
  <Section tone="paper" heading="How the education loop closes" id="loop">
    <p>
      EdTerm captures how experienced practitioners reason. The same captured knowledge returns to curriculum, so the
      next cohort trains on what practitioners actually learned.
    </p>
    <!--
      Closed loop: the frame's top edge (desktop) or left edge (mobile) joins the steps in order;
      the rest of the frame is the return path from the next cohort back to practice.
      Step text is inset from its marker so no frame edge crosses it.
    -->
    <div slot="wide" class="relative mb-8 lg:mt-6">
      <span
        class="pointer-events-none absolute bottom-[-1.5rem] left-[7px] right-0 top-[9px] rounded-[1.5rem] rounded-tl-none border-2 border-purple-700/30 md:bottom-[-2rem] md:top-[7px] md:rounded-[2rem] md:rounded-tl-none"
        aria-hidden="true"
      ></span>
      <ol class="relative grid md:grid-cols-4 md:gap-x-(--spacing-gutter)" aria-label="The education loop">
        {
          loop.map((step, i) => (
            <li class="relative pb-10 pl-10 pr-6 last:pb-0 md:pb-0 md:pl-8 md:pr-6 md:pt-12">
              <span
                class="absolute left-0 top-px size-4 rounded-full border-2 border-purple-700 bg-paper md:top-0"
                aria-hidden="true"
              />
              <span class="label block text-purple-700">{i + 1}</span>
              <h3 class="mt-2 text-h3 font-bold text-navy">{step.name}</h3>
              <p class="mt-3 max-w-[30ch] text-ink-muted">{step.line}</p>
            </li>
          ))
        }
      </ol>
      <p class="sr-only">After the next cohort enters practice, the loop begins again.</p>
    </div>
  </Section>

  <!-- One source, two outcomes: link back to the data layer -->
  <Section tone="white" heading="One source, two outcomes" id="one-source">
    <p>The reasoning that returns to curriculum is the same reasoning that completes the healthcare data layer.</p>
    <p>Both loops close from the same source.</p>
    <p><a href="/health-systems" class={link}>See how it completes the data layer</a></p>
  </Section>

  <CTA heading="Early Access" buttonLabel="Start a conversation" />
</BaseLayout>
