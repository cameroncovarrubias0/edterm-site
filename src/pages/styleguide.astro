---
// Internal review page for the design system. Always noindexed, not in nav/footer, excluded from the sitemap.
// Remove before launch.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProofCard from '../components/ProofCard.astro';
import CTA from '../components/CTA.astro';
import Button from '../components/Button.astro';

const colors = [
  { name: 'Navy', hex: '#121331', cls: 'bg-navy', role: 'Text, hero start, header' },
  { name: 'Deep', hex: '#0d0d25', cls: 'bg-deep', role: 'Dark band' },
  { name: 'Purple 900', hex: '#29056b', cls: 'bg-purple-900', role: 'Hero gradient' },
  { name: 'Purple 700', hex: '#4a1d9e', cls: 'bg-purple-700', role: 'Headings on light' },
  { name: 'Purple 500', hex: '#7c3aed', cls: 'bg-purple-500', role: 'Links, focus' },
  { name: 'Gold 500', hex: '#c9a84c', cls: 'bg-gold-500', role: 'Early Access, reasoning layer' },
  { name: 'Gold 300', hex: '#e8c97a', cls: 'bg-gold-300', role: 'Text on dark only' },
  { name: 'Paper', hex: '#f8f7fc', cls: 'bg-paper border border-line', role: 'Light sections' },
];

const type = [
  { name: 'Display', cls: 'text-display font-display font-extrabold', meta: 'Plus Jakarta Sans 800 · 40→76px' },
  { name: 'H1', cls: 'text-h1 font-display font-extrabold', meta: 'Plus Jakarta Sans 800 · 36→60px' },
  { name: 'H2', cls: 'text-h2 font-display font-bold text-purple-700', meta: 'Plus Jakarta Sans 700 · 28→44px' },
  { name: 'H3', cls: 'text-h3 font-display font-bold', meta: 'Plus Jakarta Sans 700 · 20→28px' },
  { name: 'Lead', cls: 'text-lead', meta: 'Inter 400 · 19→22px' },
  { name: 'Body', cls: 'text-body', meta: 'Inter 400 · 17→18px' },
  { name: 'Small', cls: 'text-small', meta: 'Inter 400 · 14px' },
];
---

<BaseLayout title="Design system | EdTerm" description="Internal design system review page." noindex>
  <Hero
    label="Healthcare data infrastructure"
    headline="The future of healthcare is data-driven. The question is what data AI is actually learning from."
  >
    <p>
      EdTerm is a healthcare data infrastructure company building the reasoning layer that completes what EHRs and
      genomic databases cannot capture: how experienced clinicians reason through a decision before it’s lost to
      turnover. Everyday expertise is walking out the door.
    </p>
  </Hero>

  <Section tone="white" layout="stack">
    <p class="text-lead">
      Right now it's learning from outcomes and records. But the judgment, the ethics, the human touch that separates
      great clinical care from efficient clinical processing — that's not in the dataset. If we don't put it there
      intentionally, AI systems will optimize around it. EdTerm captures it.
    </p>
  </Section>

  <Section tone="paper" heading="Section block, split layout">
    <p>
      Patient data tells you what happened. Genomic data tells you what's possible. The wisdom layer tells you how
      experienced clinicians interpret all of it.
    </p>
    <p><a href="/reasoning-layer" class="font-semibold text-purple-700 underline underline-offset-4 hover:text-purple-500">Explore the reasoning layer</a></p>
  </Section>

  <Section tone="white" layout="stack" heading="Colors">
    <ul slot="wide" class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        colors.map((c) => (
          <li>
            <div class:list={['h-20 rounded-card', c.cls]} />
            <p class="mt-2 text-small font-semibold">{c.name}</p>
            <p class="label text-ink-muted">{c.hex}</p>
            <p class="text-small text-ink-muted">{c.role}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="paper" layout="stack" heading="Type scale">
    <div slot="wide" class="space-y-8">
      {
        type.map((t) => (
          <div class="border-b border-line pb-6">
            <p class="label text-ink-muted">{t.name} · {t.meta}</p>
            <p class:list={['mt-2', t.cls]}>Data doesn't diagnose. Data doesn't decide.</p>
          </div>
        ))
      }
      <div class="border-b border-line pb-6">
        <p class="label text-ink-muted">Label · DM Mono 500 · 13px</p>
        <p class="label mt-2">Healthcare data infrastructure</p>
      </div>
      <div class="pb-6">
        <p class="label text-ink-muted">Founder quote only · Playfair Display italic · 28→40px</p>
        <blockquote class="mt-2 font-quote text-quote italic">
          “You can read something in a book, or you can do it for 30 years. They are not the same.”
        </blockquote>
      </div>
    </div>
  </Section>

  <Section tone="white" layout="stack" heading="Buttons">
    <div class="flex flex-wrap gap-4">
      <Button href="/early-access">Early Access</Button>
      <Button href="/early-access" variant="secondary">Request early access</Button>
    </div>
  </Section>

  <Section tone="deep" layout="stack" heading="Proof cards">
    <ul slot="wide" class="grid gap-4 md:grid-cols-3">
      <li><ProofCard title="Peer-reviewed methodology" text="Double-blind peer review through IAFOR." href="/evidence#peer-review" /></li>
      <li><ProofCard title="IRB-approved study" text="An IRB-approved study through Lindenwood University, now open for participants." href="/evidence#lindenwood-study" /></li>
      <li><ProofCard title="18th Annual Asian Conference on Education (ACE2026), Tokyo, 2026" text="Presented the Wisdom Journalism methodology as curriculum design." href="/evidence#ace2026" /></li>
    </ul>
    <div class="flex flex-wrap gap-4 pt-6">
      <Button href="/evidence" variant="on-dark">See the evidence</Button>
    </div>
  </Section>

  <CTA heading="Help shape the reasoning layer." buttonLabel="Request early access" />
</BaseLayout>
