---
import LayerBands from './LayerBands.astro';

interface Props {
  /** Small mono label above the headline (the brief's Veeva-style label). */
  label: string;
  /** The page's h1. */
  headline: string;
}
const { label, headline } = Astro.props;
---

<!--
  Full-width navy→purple block with rounded bottom corners. Label, one headline,
  one short supporting line (default slot), nothing else competing.
  Optional `actions` slot for a single button where the brief asks for one (e.g. For Health Systems).
-->
<section class="on-dark relative overflow-hidden rounded-b-hero bg-[linear-gradient(135deg,var(--color-navy)_0%,var(--color-navy)_35%,var(--color-purple-900)_75%,var(--color-purple-700)_100%)] text-white">
  <div class="container-site grid-12 pb-20 pt-16 sm:pb-28 sm:pt-24 lg:pb-32 lg:pt-28">
    <div class="col-span-12 lg:col-span-10 xl:col-span-9" data-reveal>
      <p class="label text-gold-300">{label}</p>
      <h1 class="mt-6 text-display font-extrabold">{headline}</h1>
    </div>
    {
      Astro.slots.has('default') && (
        <div class="col-span-12 mt-8 max-w-(--container-lead) text-lead text-white/85 lg:col-span-8 xl:col-span-7" data-reveal>
          <slot />
        </div>
      )
    }
    {
      Astro.slots.has('actions') && (
        <div class="col-span-12 mt-10 flex flex-wrap gap-4" data-reveal>
          <slot name="actions" />
        </div>
      )
    }
    <LayerBands class="col-span-12 mt-12 text-white sm:mt-16" />
  </div>
</section>
